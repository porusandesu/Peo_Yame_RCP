<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Peo Yame</AssemblyName>
    <Version Condition="'$(BuildNumber)' != ''">1.0.$(BuildNumber)</Version>
    <ApplicationIcon Condition="'$(PeoYameIconPath)' != ''">$(PeoYameIconPath)</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup Condition="'$(PeoYameBundlePath)' != ''">
    <EmbeddedResource Include="$(PeoYameBundlePath)" LogicalName="PeoYame.bundle.zip" />
  </ItemGroup>
  <ItemGroup Condition="'$(PeoYameIconPath)' != ''">
    <EmbeddedResource Include="$(PeoYameIconPath)" LogicalName="PeoYame.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
